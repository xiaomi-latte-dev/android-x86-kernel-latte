diff --git a/drivers/gpu/drm/i915/display/intel_display_driver.c b/drivers/gpu/drm/i915/display/intel_display_driver.c
index 069426d92..966ab3772 100644
--- a/drivers/gpu/drm/i915/display/intel_display_driver.c
+++ b/drivers/gpu/drm/i915/display/intel_display_driver.c
@@ -223,6 +223,9 @@ int intel_display_driver_probe_noirq(struct drm_i915_private *i915)
 	if (ret)
 		goto cleanup_bios;
 
+	/* quirks must be registered before power domain init (INIT domain consults them) */
+	intel_init_quirks(display);
+
 	/* FIXME: completely on the wrong abstraction layer */
 	ret = intel_power_domains_init(i915);
 	if (ret < 0)
@@ -263,8 +266,6 @@ int intel_display_driver_probe_noirq(struct drm_i915_private *i915)
 	if (ret)
 		goto cleanup_vga_client_pw_domain_dmc;
 
-	intel_init_quirks(display);
-
 	intel_fbc_init(display);
 
 	return 0;
diff --git a/drivers/gpu/drm/i915/display/intel_display_power.c b/drivers/gpu/drm/i915/display/intel_display_power.c
index ef2fdbf97..302af0574 100644
--- a/drivers/gpu/drm/i915/display/intel_display_power.c
+++ b/drivers/gpu/drm/i915/display/intel_display_power.c
@@ -23,6 +23,7 @@
 #include "intel_pcode.h"
 #include "intel_pmdemand.h"
 #include "intel_pps_regs.h"
+#include "intel_quirks.h"
 #include "intel_snps_phy.h"
 #include "skl_watermark.h"
 #include "skl_watermark_regs.h"
@@ -997,6 +998,7 @@ static u32 get_allowed_dc_mask(const struct drm_i915_private *dev_priv,
 int intel_power_domains_init(struct drm_i915_private *dev_priv)
 {
 	struct i915_power_domains *power_domains = &dev_priv->display.power.domains;
+	int ret;
 
 	dev_priv->display.params.disable_power_well =
 		sanitize_disable_power_well_option(dev_priv,
@@ -1012,7 +1014,29 @@ int intel_power_domains_init(struct drm_i915_private *dev_priv)
 	INIT_DELAYED_WORK(&power_domains->async_put_work,
 			  intel_display_power_put_async_work);
 
-	return intel_display_power_map_init(power_domains);
+	ret = intel_display_power_map_init(power_domains);
+	if (ret)
+		return ret;
+
+	/*
+	 * The Xiaomi Mi Pad 2 (CHV) has no DP/HDMI outputs at all (its VBT
+	 * only declares the internal MIPI panel), so force-enabling the
+	 * dpio-common-bc power well at init time hangs the P-Unit
+	 * (drm/i915 issue #4385). Instead of special-casing the device inside
+	 * the power domain get/put hot paths, drop POWER_DOMAIN_INIT from that
+	 * well's domain mask: the generic power well code then never
+	 * force-enables it, while the well stays usable for the DDI/AUX
+	 * domains it actually serves.
+	 */
+	if (intel_has_quirk(&dev_priv->display, QUIRK_NO_VLV_DISP_PW_DPIO_CMN_BC_INIT)) {
+		struct i915_power_well *power_well;
+
+		power_well = lookup_power_well(dev_priv, VLV_DISP_PW_DPIO_CMN_BC);
+		if (power_well)
+			clear_bit(POWER_DOMAIN_INIT, power_well->domains.bits);
+	}
+
+	return 0;
 }
 
